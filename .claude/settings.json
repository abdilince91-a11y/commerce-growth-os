{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/client_secret*.json)",
      "Read(**/service-account*.json)",
      "Read(**/application_default_credentials.json)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.staging)",
      "Edit(.env.test)",
      "Edit(secrets/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push --force-reset *)",
      "Bash(claude --dangerously-skip-permissions *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm publish *)",
      "Bash(npm run prisma:migrate *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(prisma *)",
      "Bash(docker push *)",
      "Bash(docker run *)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(firebase *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(terraform *)",
      "Bash(kubectl *)",
      "Bash(claude mcp *)",
      "Edit(.claude/**)",
      "Edit(.mcp.json)",
      "Edit(CLAUDE.md)",
      "Edit(.github/workflows/**)",
      "Edit(**/package-lock.json)",
      "Edit(prisma/migrations/**)",
      "mcp__*"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(npm audit *)"
    ]
  },
  "enableAllProjectMcpServers": false
}
